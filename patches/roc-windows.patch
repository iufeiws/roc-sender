diff --git a/src/internal_modules/roc_core/target_windows/roc_core/time.cpp b/src/internal_modules/roc_core/target_windows/roc_core/time.cpp
new file mode 100644
index 0000000..3f886f1
--- /dev/null
+++ b/src/internal_modules/roc_core/target_windows/roc_core/time.cpp
@@ -0,0 +1,46 @@
+/*
+ * Copyright (c) 2026 Roc Streaming authors
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+#include "roc_core/windows.h"
+#include "roc_core/time.h"
+#include "roc_core/panic.h"
+namespace roc { namespace core {
+nanoseconds_t timestamp(clock_t clock) {
+    if (clock == ClockMonotonic) {
+        LARGE_INTEGER ticks, frequency;
+        if (!QueryPerformanceCounter(&ticks) || !QueryPerformanceFrequency(&frequency)) roc_panic("time: performance counter failed");
+        return (ticks.QuadPart / frequency.QuadPart) * Second + (ticks.QuadPart % frequency.QuadPart) * Second / frequency.QuadPart;
+    }
+    FILETIME ft; GetSystemTimePreciseAsFileTime(&ft);
+    ULARGE_INTEGER value; value.LowPart = ft.dwLowDateTime; value.HighPart = ft.dwHighDateTime;
+    return nanoseconds_t(value.QuadPart - 116444736000000000ULL) * 100;
+}
+void sleep_for(clock_t, nanoseconds_t ns) {
+    if (ns <= 0) return;
+    HANDLE timer = CreateWaitableTimerExW(NULL, NULL, 0x00000002, TIMER_ALL_ACCESS);
+    if (!timer) roc_panic("time: high resolution waitable timer creation failed: %lu", GetLastError());
+    LARGE_INTEGER due; due.QuadPart = -(ns / 100 + (ns % 100 != 0));
+    if (!SetWaitableTimer(timer, &due, 0, NULL, NULL, FALSE)) roc_panic("time: timer setup failed: %lu", GetLastError());
+    if (WaitForSingleObject(timer, INFINITE) != WAIT_OBJECT_0) roc_panic("time: timer wait failed: %lu", GetLastError());
+    if (!CloseHandle(timer)) roc_panic("time: timer close failed: %lu", GetLastError());
+}
+void sleep_until(clock_t clock, nanoseconds_t ns) {
+    nanoseconds_t left = ns - timestamp(clock);
+    while (left > 0) { sleep_for(clock, left); left = ns - timestamp(clock); }
+}
+std::tm nanoseconds_2_tm(nanoseconds_t timestamp) {
+    time_t seconds = time_t(timestamp / Second); std::tm result;
+    if (localtime_s(&result, &seconds)) roc_panic("time: localtime_s failed");
+    return result;
+}
+nanoseconds_t tm_2_nanoseconds(std::tm tm) {
+    time_t result = mktime(&tm);
+    if (result == (time_t)-1) roc_panic("time: mktime failed");
+    return nanoseconds_t(result) * Second;
+}
+} }
+
