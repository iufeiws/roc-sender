+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+#include "roc_core/semaphore.h"
+#include "roc_core/panic.h"
+#include "roc_core/cpu_instructions.h"
+namespace roc { namespace core {
+Semaphore::Semaphore(unsigned counter) : guard_(0) {
+    roc_panic_if(counter > LONG_MAX);
+    sem_ = CreateSemaphoreW(NULL, LONG(counter), LONG_MAX, NULL);
+    if (!sem_) roc_panic("semaphore: creation failed: %lu", GetLastError());
+}
+Semaphore::~Semaphore() { while (guard_) cpu_relax(); if (!CloseHandle(sem_)) roc_panic("semaphore: close failed: %lu", GetLastError()); }
+bool Semaphore::timed_wait(nanoseconds_t deadline) {
+    roc_panic_if(deadline < 0);
+    for (;;) {
+        nanoseconds_t left = deadline - timestamp(ClockUnix);
+        DWORD ms = left <= 0 ? 0 : DWORD(std::min<nanoseconds_t>((left + Millisecond - 1) / Millisecond, INFINITE - 1));
+        DWORD result = WaitForSingleObject(sem_, ms);
+        if (result == WAIT_OBJECT_0) return true;
+        if (result != WAIT_TIMEOUT) roc_panic("semaphore: wait failed: %lu", GetLastError());
+        if (timestamp(ClockUnix) >= deadline) return false;
+    }
+}
+void Semaphore::wait() { if (WaitForSingleObject(sem_, INFINITE) != WAIT_OBJECT_0) roc_panic("semaphore: wait failed: %lu", GetLastError()); }
+void Semaphore::post() { ++guard_; if (!ReleaseSemaphore(sem_, 1, NULL)) roc_panic("semaphore: post failed: %lu", GetLastError()); --guard_; }
+} }
+
+
