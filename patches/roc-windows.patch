+#ifndef ROC_CORE_SINGLETON_H_
+#define ROC_CORE_SINGLETON_H_
+#include "roc_core/windows.h"
+#include "roc_core/aligned_storage.h"
+#include "roc_core/noncopyable.h"
+#include "roc_core/panic.h"
+namespace roc { namespace core {
+template<class T> class Singleton : public NonCopyable<> {
+public:
+    static T& instance() {
+        if (!InitOnceExecuteOnce(&once_, create_, NULL, NULL)) roc_panic("singleton: initialization failed");
+        return *instance_;
+    }
+private:
+    static BOOL CALLBACK create_(PINIT_ONCE, PVOID, PVOID*) {
+        instance_ = new (storage_.memory()) T; return TRUE;
+    }
+    static INIT_ONCE once_;
+    static AlignedStorage<sizeof(T)> storage_;
+    static T* instance_;
+};
+template<class T> INIT_ONCE Singleton<T>::once_ = INIT_ONCE_STATIC_INIT;
+template<class T> AlignedStorage<sizeof(T)> Singleton<T>::storage_;
+template<class T> T* Singleton<T>::instance_;
+} }
+#endif
