@@ -0,0 +1,34 @@
+/*
+ * Copyright (c) 2026 Roc Streaming authors
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+#include "roc_core/cond.h"
+namespace roc { namespace core {
+bool Cond::timed_wait(nanoseconds_t timeout) const {
+    roc_panic_if(timeout < 0);
+    const nanoseconds_t deadline = timestamp(ClockMonotonic) + timeout;
+    for (;;) {
+        nanoseconds_t left = deadline - timestamp(ClockMonotonic);
+        DWORD ms = left <= 0 ? 0 : DWORD(std::min<nanoseconds_t>((left + Millisecond - 1) / Millisecond, INFINITE - 1));
+        InterlockedExchange(&mutex_.owner_, 0);
+        BOOL ok = SleepConditionVariableSRW(&cond_, &mutex_.mutex_, ms, 0);
+        DWORD error = ok ? 0 : GetLastError();
+        InterlockedExchange(&mutex_.owner_, LONG(GetCurrentThreadId()));
+        if (ok) return true;
+        if (error != ERROR_TIMEOUT) roc_panic("cond: wait failed: %lu", error);
+        if (timestamp(ClockMonotonic) >= deadline) return false;
+    }
+}
+void Cond::wait() const {
+    InterlockedExchange(&mutex_.owner_, 0);
+    BOOL ok = SleepConditionVariableSRW(&cond_, &mutex_.mutex_, INFINITE, 0);
+    DWORD error = ok ? 0 : GetLastError();
+    InterlockedExchange(&mutex_.owner_, LONG(GetCurrentThreadId()));
+    if (!ok) roc_panic("cond: wait failed: %lu", error);
+}
+} }
+
+
