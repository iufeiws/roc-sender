@@ -0,0 +1,46 @@
+/*
+ * Copyright (c) 2026 Roc Streaming authors
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+#ifndef ROC_CORE_MUTEX_H_
+#define ROC_CORE_MUTEX_H_
+#include "roc_core/windows.h"
+#include "roc_core/noncopyable.h"
+#include "roc_core/scoped_lock.h"
+#include "roc_core/attributes.h"
+#include "roc_core/panic.h"
+#include "roc_core/atomic.h"
+#include "roc_core/cpu_instructions.h"
+namespace roc { namespace core {
+class Cond;
+class Mutex : public NonCopyable<> {
+public:
+    typedef ScopedLock<Mutex> Lock;
+    Mutex() : owner_(0), guard_(0) { InitializeSRWLock(&mutex_); }
+    ~Mutex() { while (guard_) cpu_relax(); roc_panic_if(InterlockedCompareExchange(&owner_, 0, 0) != 0); }
+    ROC_ATTR_NODISCARD bool try_lock() const {
+        if (!TryAcquireSRWLockExclusive(&mutex_)) return false;
+        InterlockedExchange(&owner_, LONG(GetCurrentThreadId())); return true;
+    }
+    void lock() const {
+        roc_panic_if(DWORD(InterlockedCompareExchange(&owner_, 0, 0)) == GetCurrentThreadId());
+        AcquireSRWLockExclusive(&mutex_); InterlockedExchange(&owner_, LONG(GetCurrentThreadId()));
+    }
+    void unlock() const {
+        roc_panic_if(DWORD(InterlockedCompareExchange(&owner_, 0, 0)) != GetCurrentThreadId());
+        ++guard_; InterlockedExchange(&owner_, 0); ReleaseSRWLockExclusive(&mutex_); --guard_;
+    }
+private:
+    friend class Cond;
+    mutable SRWLOCK mutex_;
+    mutable volatile LONG owner_;
+    mutable Atomic<int> guard_;
+};
+} }
+#endif
+
+
+
