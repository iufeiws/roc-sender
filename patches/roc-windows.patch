+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+#include "roc_core/windows.h"
+#include "roc_core/temp_file.h"
+#include "roc_core/panic.h"
+namespace roc { namespace core {
+TempFile::TempFile(const char* name) {
+    roc_panic_if(!name || !*name || strchr(name, '/') || strchr(name, '\\'));
+    char temp[MAX_PATH];
+    DWORD length = GetTempPathA(sizeof(temp), temp);
+    if (!length || length >= sizeof(temp)) roc_panic("temp_file: GetTempPath failed");
+    for (unsigned attempt = 0;; ++attempt) {
+        if (snprintf(dir_, sizeof(dir_), "%sroc-%lu-%llu-%u", temp, GetCurrentProcessId(), (unsigned long long)GetTickCount64(), attempt) >= int(sizeof(dir_))) roc_panic("temp_file: path too long");
+        if (CreateDirectoryA(dir_, NULL)) break;
+        if (GetLastError() != ERROR_ALREADY_EXISTS) roc_panic("temp_file: directory creation failed: %lu", GetLastError());
+    }
+    if (snprintf(file_, sizeof(file_), "%s\\%s", dir_, name) >= int(sizeof(file_))) roc_panic("temp_file: path too long");
+    HANDLE file = CreateFileA(file_, GENERIC_WRITE, 0, NULL, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (file == INVALID_HANDLE_VALUE) roc_panic("temp_file: file creation failed: %lu", GetLastError());
+    if (!CloseHandle(file)) roc_panic("temp_file: close failed");
+}
+TempFile::~TempFile() {
+    if (!DeleteFileA(file_) && GetLastError() != ERROR_FILE_NOT_FOUND) roc_panic("temp_file: delete failed: %lu", GetLastError());
+    if (!RemoveDirectoryA(dir_)) roc_panic("temp_file: directory removal failed: %lu", GetLastError());
+}
+const char* TempFile::path() const { return file_; }
+} }
+
+
