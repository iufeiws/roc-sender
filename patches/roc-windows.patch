+#include "roc_core/windows.h"
+#include "roc_core/die.h"
+#include "roc_core/backtrace.h"
+#include "roc_core/stddefs.h"
+namespace roc { namespace core {
+void die_fast(int code) { TerminateProcess(GetCurrentProcess(), UINT(code)); abort(); }
+void die_gracefully(const char* message, bool full_backtrace) {
+    static volatile LONG dying = 0;
+    if (InterlockedCompareExchange(&dying, 1, 0) == 0) {
+        fprintf(stderr, "\nERROR: %s\n\n", message); fflush(stderr);
+        if (full_backtrace) print_backtrace_full(); else print_backtrace_safe();
+    }
+    die_fast(1);
+}
+} }
