--- /dev/null
+++ b/src/internal_modules/roc_core/target_windows/roc_core/thread.cpp
@@ -0,0 +1,40 @@
+/*
+ * Copyright (c) 2026 Roc Streaming authors
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+#include <process.h>
+#include "roc_core/thread.h"
+#include "roc_core/log.h"
+#include "roc_core/panic.h"
+namespace roc { namespace core {
+uint64_t Thread::get_pid() { return GetCurrentProcessId(); }
+uint64_t Thread::get_tid() { return GetCurrentThreadId(); }
+bool Thread::enable_realtime() {
+    if (!SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_TIME_CRITICAL)) {
+        roc_log(LogError, "thread: SetThreadPriority failed: %lu", GetLastError()); return false;
+    }
+    return true;
+}
+Thread::Thread() : thread_(NULL), started_(0), joinable_(0) {}
+Thread::~Thread() { roc_panic_if(is_joinable()); }
+bool Thread::is_joinable() const { return joinable_; }
+bool Thread::start() {
+    Mutex::Lock lock(mutex_);
+    if (started_) { roc_log(LogError, "thread: can't start thread more than once"); return false; }
+    thread_ = reinterpret_cast<HANDLE>(_beginthreadex(NULL, 0, &Thread::thread_runner_, this, 0, NULL));
+    if (!thread_) { roc_log(LogError, "thread: _beginthreadex failed"); return false; }
+    started_ = 1; joinable_ = 1; return true;
+}
+void Thread::join() {
+    Mutex::Lock lock(mutex_);
+    if (!joinable_) return;
+    if (WaitForSingleObject(thread_, INFINITE) != WAIT_OBJECT_0) roc_panic("thread: join failed: %lu", GetLastError());
+    if (!CloseHandle(thread_)) roc_panic("thread: CloseHandle failed: %lu", GetLastError());
+    thread_ = NULL; joinable_ = 0;
+}
+unsigned __stdcall Thread::thread_runner_(void* ptr) { static_cast<Thread*>(ptr)->run(); return 0; }
+} }
+
